generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senhaHash   String
  nivelAcesso String   @default("pesquisador")
  createdAt   DateTime @default(now())
}

model Projeto {
  id             Int                    @id @default(autoincrement())
  codigo         String                 @unique
  titulo         String
  descricao      String?
  dataInicio     DateTime
  dataTermino    DateTime
  orcamentoGlobal Decimal                @db.Decimal(12, 2)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  alocacoes      AlocacaoOrcamentaria[]
  despesas       Despesa[]
}

model Rubrica {
  id          Int                   @id @default(autoincrement())
  codigoAneel String                @unique
  descricao   String
  ordem       Int                   @default(0)
  alocacoes   AlocacaoOrcamentaria[]
  despesas    Despesa[]
}

model AlocacaoOrcamentaria {
  id            Int     @id @default(autoincrement())
  projetoId     Int
  rubricaId     Int
  valorPrevisto Decimal @db.Decimal(12, 2)
  projeto       Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  rubrica       Rubrica @relation(fields: [rubricaId], references: [id])

  @@unique([projetoId, rubricaId])
}

model Despesa {
  id             Int      @id @default(autoincrement())
  projetoId      Int
  rubricaId      Int
  dataDespesa    DateTime
  valorExecutado Decimal  @db.Decimal(12, 2)
  descricao      String
  comprovanteUrl String?
  createdAt      DateTime @default(now())
  projeto        Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  rubrica        Rubrica  @relation(fields: [rubricaId], references: [id])

  @@index([projetoId])
}
